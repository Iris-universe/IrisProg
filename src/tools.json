 {
  "name": "list_emails",
  "description": "Liste les mails (depuis le cache local, synchronisé régulièrement) : uid, expéditeur, objet, date, lu, catégorie, extrait, artiste lié.",
  "parameters": {
   "type": "object",
   "properties": {
    "folder": {
     "type": "string",
     "description": "défaut INBOX"
    },
    "unread_only": {
     "type": "boolean"
    },
    "category": {
     "type": "string",
     "enum": [
      "booking",
      "candidature",
      "admin",
      "presse",
      "autre"
     ]
    },
    "query": {
     "type": "string"
    },
    "limit": {
     "type": "integer"
    }
   },
   "required": []
  }
 },
 {
  "name": "read_email",
